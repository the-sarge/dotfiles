# Machine-wide RAS defaults. Project config in .ras/config.yaml overrides these.
# Set per-agent models here; model_profiles can list agents by name only and inherit
# these defaults unless a profile entry sets model: explicitly.
data_dir: ".ras/data"

# Local read-only web UI.
serve:
  addr: 127.0.0.1:1948
  # Optional aggregate mode inputs.
  # workspaces:
  #   - ..
  # projects:
  #   - ../other-project

# ----------------------
# AGENT CONFIGURATIONS
# ----------------------

  # Configured review agents. ras runs every configured agent unless --agents is
# passed.
agents:
  codex:
    preset: codex
    model: gpt-5.4
    structured_delivery: prompt_only
    # timeout_seconds overrides review.timeout_seconds for this agent.
    # timeout_seconds: 900
    # env adds process environment variables for this agent.
    # env:
    #   EXAMPLE: value
  codex-sol:
    preset: codex
    model: gpt-5.6-sol
    reasoning_effort_control: codex_config
    reasoning_effort: high
    structured_delivery: prompt_only
  luna-max:
    preset: codex
    model: gpt-5.6-luna
    reasoning_effort_control: codex_config
    reasoning_effort: max
    structured_delivery: prompt_only
  claude-opus:
    type: subprocess
    command: ["claude", "--model", "{model}", "--effort", "high", "--permission-mode", "bypassPermissions", "-p"]
    model: opus
    # timeout_seconds: 900
  claude-fable:
    type: subprocess
    command: ["claude", "--model", "{model}", "--effort", "high", "--permission-mode", "bypassPermissions", "-p"]
    model: fable
    # timeout_seconds: 900
  agy-flash:
    preset: agy
    model: gemini-3.6-flash-high
    # timeout_seconds: 900
  agy-pro:
    preset: agy
    model: gemini-3.1-pro-high
    # timeout_seconds: 900
  grok:
    type: subprocess
    command: ["grok", "--always-approve", "--effort", "high", "-m", "{model}", "--prompt-file", "/dev/stdin"]
    model: grok-4.5
    # timeout_seconds: 900
  grok-composer:
    type: subprocess
    command: ["grok", "--always-approve", "-m", "{model}", "--prompt-file", "/dev/stdin"]
    model: grok-composer-2.5
    # timeout_seconds: 900
  cursor-composer:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: composer-2.5
  cursor-gpt:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: gpt-5.5-extra-high
  cursor-opus:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: claude-opus-4-8-thinking-xhigh
  cursor-fable:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: claude-fable-5-thinking-high
  cursor-grok:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: grok-4.5-xhigh
#   cursor-grok-build:
#     type: subprocess
#     command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
#     model: grok-build-0.1
  cursor-gemini-flash:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: gemini-3.5-flash
  cursor-gemini-pro:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: gemini-3.1-pro
  cursor-glm:
    type: subprocess
    command: ["cursor-agent", "--trust", "--yolo", "--model", "{model}", "-p"]
    model: glm-5.2-high


# -------------
# AGENT ROLES
# -------------

    # Builder used by ras implement.
builder:
  #   command: ["cursor-agent", "--print", "--trust", "--yolo", "--model", "{model}"]
  #   model: composer-2.5-fast
  command: ["codex", "exec", "--sandbox", "danger-full-access", "--dangerously-bypass-approvals-and-sandbox", "-"]
  model: gpt-5.6-sol
  #   command: ["/Users/josh/.local/bin/claude-p", "--permission-mode", "bypassPermissions"]
  #   command: ["grok", "--prompt-file", "/dev/stdin", "--always-approve", "--effort", "xhigh", "-m", "grok-composer-2.5-fast"]
  timeout: 60m
    # Optional instructions included in every builder prompt.
    # instructions: |
    #   Run project checks before declaring done.

# Agent used to synthesize the final review after reviewer/adjudication rounds.
synthesis:
  agent: codex-sol

# Agent used to score experiment cells. If unset, ras uses synthesis.agent.
evaluation:
  agent: codex-sol


# ------------------------
# PROFILE CONFIGURATIONS
# ------------------------

# Optional named model profiles. A selected profile supplies the default
# multi-agent panel and per-agent models for review-like workflows.
model_profiles:
  default-review:
    agents:
      - name: codex-sol
#       - name: luna-max
      - name: claude-opus
#       - name: claude-fable
#       - name: agy-flash
#       - name: agy-pro
      - name: grok
#       - name: grok-composer
      - name: cursor-composer
#       - name: cursor-grok
#       - name: cursor-opus
      # - name: cursor-fable
#       - name: cursor-glm      
  fast-review:
    agents:
#       - name: agy-flash
      - name: cursor-composer
      - name: grok
  deep-review:
    agents:
      - name: codex-sol
      - name: luna-max
      - name: claude-fable
#         model: fable
      - name: grok
      - name: cursor-composer
#     synthesis:
#       agent: codex
#       model: gpt-5.5
#     verify:
#       agent: codex
#       model: gpt-5.5
#     builder:
#       agent: codex
#       model: gpt-5.5
  consider:
    agents:
      - name: codex-sol
      - name: claude-fable
      - name: grok

#--------------------------
# PIPELINE CONFIGURATIONS
# -------------------------

# Review pipeline controls.
review:
  model_profile: default-review
  # Optional guidance appended to the built-in ras protocol prompts.
  # prompt: |
  #   Review from architecture, code quality, idiomatic code, security,
  #   and release-readiness perspectives.

  # Per-agent timeout in seconds unless an agent-specific timeout is set.
  timeout_seconds: 3000

  # Run R2/R3 adjudication over reviewer findings before synthesis.
  adjudication: true

  # Maximum R3 conflict-resolution rounds after normal R2 adjudication.
  max_conflict_rounds: 2

  # Worktree retention policy: never, on_failure, or always.
  keep_worktrees: never

  # Minimum successful R1 reviewers required before adjudication/synthesis.
  min_successful_reviewers: 2

  # Context shapes: full, tiered, lean, chunked.
  context_shape: full

  # Delivery modes: inline, auto, session.
  # Bundled subprocess agents support inline. auto records requested delivery as
  # auto and actual delivery as the adapter-selected mode, currently inline.
  # session requires an adapter that reports session support.
  delivery_mode: inline

# consider and verify can select model profiles independently from review.
consider:
  model_profile: consider
  # Per-agent timeout in seconds unless an agent-specific timeout is set.
#   timeout_seconds: 1800
# verify:
#   model_profile: fast-review

# Implement-loop controls for ras implement.
implement:
  default_mode: pr
  # PR-backed mode options used when default_mode is pr or --open-pr is passed.
  pr_remote: origin
  # pr_base: main
  # New project configs get a larger loop budget for future PR-backed mode.
  # Projects without an implement section use the runtime fallback of 10.
  max_iterations: 20
  max_review_loops: 3
  max_fix_loops: 3
  # Optional role-specific profiles for PR-backed implementation loops.
  # builder_model_profile: review
  # review_model_profile: review
  # verify_model_profile: fast-review
  # gate_model_profile: review
  # PR-backed builders use a scrubbed environment by default.
  # pr_builder_inherit_env: false
  stuck_threshold: 3
  pr_gate:
    blocking_severities: [critical, high]
    medium_blocking_categories: [security, correctness, data_loss, migration, prd_requirement]
  default_squash: false
