if [[ -n 'which eza' ]]; then
	alias ls="eza -F --time-style=long-iso"
	alias l="ls -l --no-permissions --no-filesize --no-user --no-time"
	alias la="l -a"
	alias ll="ls -lh"
	alias lla="ls -alh"
	alias lal="ls -alh"
	alias lg="l -ah --no-permissions --no-filesize --no-user --git --git-repos"
	alias llg="ll --git --git-repos" 
fi

# alias ls="ls -FG"
# alias l="ls -1FG"
# alias la="ls -1aFG"
# alias ll="ls -alFGh"
# alias lt="ls -ltFGh"
# alias ldot="ls -ldFGh .*"
alias lv="ll /Volumes"
alias lvm="ll -M /Volumes"

alias j="z" 	# j was autojump before zoxide. I like the j key better"
alias ji="zi"

alias cat="bat"


alias bb="bbedit"
alias vi="nvim"
alias vim="nvim"
alias helix="hx"

alias zshconfig="hx ~/.zshrc"
alias sshconfig="hx ~/.ssh/config"
alias tmuxconfig="hx ~/.tmux.conf"
alias gitconfig="hx ~/.gitconfig"
alias vimconfig="hx ~/.viminfo"

alias gs='git status'
alias gss='git status -s'           # short format
alias gd='git diff'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gca='git commit -a'
alias gcm='git commit -m'
alias gcam='git commit -am'
alias gp='git push'
alias gpl='git pull'
alias gf='git fetch'
alias gfa='git fetch --all --prune'
alias gm='git merge'
