if [[ -n 'which eza' ]]; then
	alias ls="eza -F --time-style=long-iso"
	alias l="ls -l --no-permissions --no-filesize --no-user --no-time"
	alias la="l -a"
	alias lg="l -ah --no-permissions --no-filesize --no-user --git --git-repos"
	alias ll="ls -alh"
	alias llg="ll --git --git-repos" 
fi

# alias ls="ls -FG"
# alias l="ls -1FG"
# alias la="ls -1aFG"
# alias ll="ls -alFGh"
# alias lt="ls -ltFGh"
# alias ldot="ls -ldFGh .*"
alias lv="ll /Volumes"
alias lvm="ll -M /Volumes"

alias bb="bbedit --wait --resume"
alias vi="nvim"
alias vim="nvim"
alias helix="hx"

alias zshconfig="bb ~/.zshrc"
