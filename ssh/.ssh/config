# =============================================================================
# SSH config — read this before editing!
#
# ORDERING MATTERS. SSH applies the FIRST matching value for any given option.
# That means specific blocks (github, *-agentcooper-*) MUST come before the
# catch-all `Host *` at the bottom, or `Host *` will set User=josh first and
# the more-specific blocks won't be able to override it.
#
# Layout:
#   1. Specific overrides (github, agentcooper)  — MUST be at top
#   2. Path blocks (set HostName per network path) — order within this section
#      doesn't matter, since these only set HostName/Ciphers/etc, not User
#   3. Catch-all defaults (Host *)               — MUST be at bottom
#
# Aliases this gives you:
#   josh (default user, no suffix needed):
#     m4mini-tb, m4mini-eth, m4mini-wifi, m4mini-ts   (m4mini has 4 paths)
#     imacpro, imacpro-ts, mbp128, mbp128-ts, mba13m4
#   agentcooper:
#     m4mini-agentcooper-tb, -eth, -wifi, -ts
#     imacpro-agentcooper, -ts; mbp128-agentcooper, -ts; mba13m4-agentcooper
#
# Verify after edits:
#   ssh -G m4mini-tb | grep -E "^(user|hostname|identityfile|forwardagent) "
#   ssh -G m4mini-agentcooper-tb | grep -E "^(user|hostname|identityfile) "
#   ssh -G github | grep -E "^(user|hostname|identityfile) "
# =============================================================================


# -----------------------------------------------------------------------------
# SECTION 1: Specific overrides — KEEP AT TOP (before `Host *`)
# These blocks set User and IdentityFile, which would otherwise be locked in
# by the catch-all defaults. First match wins, so these must come first.
# -----------------------------------------------------------------------------




Include ~/.ssh/config.d/infra-dev-agent.conf

Host github github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/GitHub
    IdentitiesOnly yes
    # No ForwardAgent — never forward agent to a code host.


Host *-agentcooper-* *-agentcooper
    User agentcooper
    IdentityFile ~/.ssh/id_ed25519_agentcooper
    # Inherits IdentitiesOnly, ForwardAgent, etc. from `Host *` at bottom.


# -----------------------------------------------------------------------------
# SECTION 2: Network path blocks — order within this section doesn't matter
# Each block only sets HostName (and sometimes Ciphers/Compression for wired
# paths). User and key come from Section 1 or Section 3 depending on alias.
#
# m4mini has multiple explicit local paths. imacpro and mbp128 default to
# local LAN addresses, with explicit -ts aliases for Tailscale fallback.
# Verify Tailscale paths with: tailscale ping <host>
#
# m4mini paths in performance order:
#   tb   = Thunderbolt   (fastest)
#   eth  = Ethernet
#   wifi = Wi-Fi
#   ts   = Tailscale     (use when traveling, or always if you don't care)
# -----------------------------------------------------------------------------

# m4mini — Thunderbolt (fastest local path)
# AES-GCM cipher: faster than default chacha20 on Apple Silicon (AES-NI HW accel).
# Compression off: bandwidth abundant, CPU is the bottleneck.
Host m4mini-tb m4mini-agentcooper-tb
    HostName 172.16.1.1
    HostKeyAlias m4mini
    Ciphers aes128-gcm@openssh.com
    Compression no

# m4mini — Ethernet (gigabit)
# Same cipher tweak as Thunderbolt for the same reason.
Host m4mini-eth m4mini-agentcooper-eth
    HostName 192.168.1.2
    HostKeyAlias m4mini
    Ciphers aes128-gcm@openssh.com
    Compression no

# m4mini — Wi-Fi (network is the bottleneck, leave defaults)
Host m4mini-wifi m4mini-agentcooper-wifi
    HostName 192.168.1.32
    HostKeyAlias m4mini

# m4mini — Tailscale (use when away from home, or as fallback)
Host m4mini-ts m4mini-agentcooper-ts
    HostName 100.68.146.61
    HostKeyAlias m4mini

# imacpro — Ethernet / LAN
Host imacpro imacpro-agentcooper
    HostName 192.168.1.8
    HostKeyAlias imacpro

# imacpro — Tailscale
Host imacpro-ts imacpro-agentcooper-ts
    HostName 100.82.28.111
    HostKeyAlias imacpro

# mbp128 — Ethernet / LAN
Host mbp128 mbp128-agentcooper
    HostName 192.168.1.10
    HostKeyAlias mbp128

# mbp128 — Tailscale
Host mbp128-ts mbp128-agentcooper-ts
    HostName 100.73.220.45
    HostKeyAlias mbp128

# mba13m4 (laptop) — Tailscale only
Host mba13m4 mba13m4-agentcooper
    HostName 100.70.254.24
    HostKeyAlias mba13m4


# -----------------------------------------------------------------------------
# SECTION 3: Catch-all defaults — KEEP AT BOTTOM (must come after specific
# blocks above, or it will lock in User=josh and IdentityFile before the
# github / agentcooper blocks get a chance to override.)
#
# Default user is josh, so josh aliases don't need a username suffix
# (e.g. `ssh m4mini-tb` connects as josh). Only agentcooper needs the
# explicit -agentcooper or -agentcooper- in the alias.
# -----------------------------------------------------------------------------

Host *
    User josh
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ForwardAgent yes
    AddKeysToAgent yes
    UseKeychain yes
    IgnoreUnknown UseKeychain,AddKeysToAgent
