# TPM plugin checkouts are managed by TPM, not this dotfiles repo.
tmux/.tmux/plugins/
tmux/.tmux/resurrect/

# Runtime logs and per-machine installer state (regenerated automatically).
btop/.config/btop/btop.log
broot/.config/broot/launcher/

# Anaconda
conda/

# Local RAS runtime files
/ras/.config/ras/.ras/
/ras/.config/ras/ras.sqlite
/ras/.config/ras/config.yaml.bak
worktrees/

# Local SQLite databases (and WAL/SHM/journal sidecars) created by tools inside stowed dirs.
*.db
*.db-*
*.sqlite
*.sqlite-*
